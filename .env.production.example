DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=gastrowo
POSTGRES_USER=gastrowo
POSTGRES_PASSWORD=change-this-long-password

DATABASE_URL=postgresql+psycopg://gastrowo:change-this-long-password@db:5432/gastrowo
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))" (API refuses to start with a weak key)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com

RESEND_API_KEY=

# Emails of GastrOWO team members allowed to open the platform panel
PLATFORM_ADMIN_EMAILS=

# Optional secret test login: open https://<site>/?test=<secret> once (24+ random characters)
DEV_LOGIN_SECRET=

# Stripe: per-person prices (quantity = team size)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Per-location prices (quantity = number of locations). Starter $26 / 99 zl, Pro $58 / 219 zl per month.
STRIPE_PRICE_STARTER_USD_MONTHLY=
STRIPE_PRICE_STARTER_USD_ANNUAL=
STRIPE_PRICE_PRO_USD_MONTHLY=
STRIPE_PRICE_PRO_USD_ANNUAL=
STRIPE_PRICE_STARTER_PLN_MONTHLY=
STRIPE_PRICE_STARTER_PLN_ANNUAL=
STRIPE_PRICE_PRO_PLN_MONTHLY=
STRIPE_PRICE_PRO_PLN_ANNUAL=
