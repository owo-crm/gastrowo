DOMAIN=app.example.com
ACME_EMAIL=ops@example.com

POSTGRES_DB=gastrowo
POSTGRES_USER=gastrowo
POSTGRES_PASSWORD=change-this-long-password

DATABASE_URL=postgresql+psycopg://gastrowo:change-this-long-password@db:5432/gastrowo
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))" (API refuses to start with a weak key)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=720

CORS_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com

RESEND_API_KEY=

# Emails of GastrOWO team members allowed to view waitlist leads
PLATFORM_ADMIN_EMAILS=

# Optional secret test login: open https://<site>/?test=<secret> once (24+ random characters)
DEV_LOGIN_SECRET=

# Stripe: per-person prices (quantity = team size)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD_MONTHLY=
STRIPE_PRICE_STANDARD_ANNUAL=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
