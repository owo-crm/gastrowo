FROM node:20-alpine AS build

WORKDIR /app

ARG VITE_API_URL=https://api-production.up.railway.app
ENV VITE_API_URL=${VITE_API_URL}
# "true" shows the one-click test admin login (the API also needs DEV_LOGIN_ENABLED=true).
ARG VITE_DEV_LOGIN=false
ENV VITE_DEV_LOGIN=${VITE_DEV_LOGIN}

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

FROM node:20-alpine

WORKDIR /app

RUN npm install -g serve

COPY --from=build /app/dist ./dist

ENV PORT=3000

EXPOSE 3000

CMD ["sh", "-c", "serve -s dist -l tcp://0.0.0.0:${PORT}"]
